{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Ledger.slnx",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "infra-up",
      "detail": "Start PostgreSQL, RabbitMQ and Keycloak and wait until they are healthy",
      "type": "shell",
      "command": "docker compose up -d --wait postgres rabbitmq keycloak",
      "problemMatcher": []
    },
    {
      "label": "migrate",
      "detail": "Apply the EF Core migrations of every module",
      "type": "shell",
      "command": "dotnet run --project src/Ledger.Migrator",
      "dependsOn": [
        "infra-up"
      ],
      "problemMatcher": []
    },
    {
      "label": "prepare-debug",
      "dependsOrder": "sequence",
      "dependsOn": [
        "migrate",
        "build"
      ],
      "problemMatcher": []
    },
    {
      "label": "full-up",
      "detail": "Run everything in containers (API on http://localhost:8081, web on http://localhost:4201)",
      "type": "shell",
      "command": "docker compose --profile full up -d --build",
      "problemMatcher": []
    },
    {
      "label": "down",
      "type": "shell",
      "command": "docker compose --profile full down",
      "problemMatcher": []
    },
    {
      "label": "web: install",
      "type": "shell",
      "command": "npm ci",
      "options": {
        "cwd": "${workspaceFolder}/clients/web"
      },
      "problemMatcher": []
    },
    {
      "label": "web: start",
      "detail": "Angular dev server on http://localhost:4200 (English); proxies /api to the API on :5209",
      "type": "npm",
      "script": "start",
      "path": "clients/web",
      "isBackground": true,
      "problemMatcher": {
        "owner": "angular",
        "pattern": {
          "regexp": "^(ERROR|✘).*$"
        },
        "background": {
          "activatesByDefault": true,
          "beginsPattern": "Building|Changes detected",
          "endsPattern": "Local:|bundle generation (complete|failed)|Watch mode enabled"
        }
      }
    },
    {
      "label": "web: start (es)",
      "type": "npm",
      "script": "start:es",
      "path": "clients/web",
      "isBackground": true,
      "problemMatcher": {
        "owner": "angular",
        "pattern": {
          "regexp": "^(ERROR|✘).*$"
        },
        "background": {
          "activatesByDefault": true,
          "beginsPattern": "Building|Changes detected",
          "endsPattern": "Local:|bundle generation (complete|failed)|Watch mode enabled"
        }
      }
    },
    {
      "label": "web: test",
      "type": "npm",
      "script": "test",
      "path": "clients/web",
      "problemMatcher": []
    },
    {
      "label": "web: e2e",
      "type": "npm",
      "script": "e2e",
      "path": "clients/web",
      "problemMatcher": []
    }
  ]
}
