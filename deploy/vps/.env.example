# Copy to /opt/ledger/.env on the server and `chmod 600 .env`. Never commit the real file.
# Generate passwords with: openssl rand -hex 24

# The app is served at ledger.<DOMAIN>, Keycloak at auth.<DOMAIN>.
DOMAIN=example.com

# Who may open the Keycloak admin console (space separated CIDRs). Your IP: curl -s https://checkip.amazonaws.com
ADMIN_CIDRS=203.0.113.7/32

POSTGRES_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me
# Bootstrap admin of the Keycloak master realm (first start only; replace it with your own admin, see §19.4).
KEYCLOAK_ADMIN_PASSWORD=change-me

# Nightly backups to Hetzner Object Storage (backup.sh). Endpoint for Falkenstein: https://fsn1.your-objectstorage.com
BACKUP_S3_ENDPOINT=https://fsn1.your-objectstorage.com
BACKUP_S3_BUCKET=ledger-backups
BACKUP_S3_ACCESS_KEY=change-me
BACKUP_S3_SECRET_KEY=change-me
