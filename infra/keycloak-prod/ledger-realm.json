{
  "realm": "ledger",
  "displayName": "Ledger",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 28800,
  "clients": [
    {
      "clientId": "ledger-api",
      "name": "Ledger API",
      "description": "Audience of the access tokens accepted by the API. No login flows.",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "ledger-console",
      "name": "Ledger Console",
      "description": "Console client: authorization code + PKCE with a loopback redirect.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:7890/*"
      ],
      "webOrigins": [
        "+"
      ],
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1:7890/*"
      },
      "protocolMappers": [
        {
          "name": "ledger-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ledger-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "ledger-web",
      "name": "Ledger Web",
      "description": "Angular web client: authorization code + PKCE.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "${LEDGER_WEB_URL}/*"
      ],
      "webOrigins": [
        "${LEDGER_WEB_URL}"
      ],
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${LEDGER_WEB_URL}/*"
      },
      "protocolMappers": [
        {
          "name": "ledger-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ledger-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "resetPasswordAllowed": false,
  "bruteForceProtected": true
}
