# Serves the English (/en/) and Spanish (/es/) builds and proxies the API (same origin, no CORS).
# Template: the nginx image replaces ${API_UPSTREAM} and ${KEYCLOAK_ISSUER} with environment variables
# at startup (defaults in the Dockerfile); nginx variables like $host are left as they are.

# Language chosen in the app (cookie set by the language switcher); English by default.
map $cookie_ledger_locale $ledger_locale {
    default en;
    es      es;
}

# Behind a load balancer that terminates HTTPS, keep the scheme the browser used.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

server {
    listen 80;
    root /usr/share/nginx/html;

    # Redirects keep the port the browser used (e.g. 4201).
    absolute_redirect off;

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location = /health {
        proxy_pass ${API_UPSTREAM};
    }

    # Per-environment settings read by the app at startup (see app.settings.ts).
    location = /config.json {
        default_type application/json;
        add_header Cache-Control "no-store";
        return 200 '{"keycloakIssuer":"${KEYCLOAK_ISSUER}"}';
    }

    # Installable app (PWA): these decide which version runs, so the browser always checks for a newer one.
    location ~ ^/(en|es)/(sw\.js|ngsw\.json|ngsw-worker\.js|safety-worker\.js|worker-basic\.min\.js)$ {
        add_header Cache-Control "no-cache";
    }

    location ~ ^/(en|es)/manifest\.webmanifest$ {
        types { }
        default_type application/manifest+json;
        add_header Cache-Control "no-cache";
    }

    # Bundles have a content hash in their name (main-Ab3_x-9Z.js): they never change, cache them for a year.
    # (Quoted: nginx would read the {8} as a block.)
    location ~ "^/(en|es)/(main|polyfills|styles|chunk|worker)-[A-Za-z0-9_-]{8}\.(js|css)$" {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Each language is a single-page app: unknown paths fall back to its index.html (never cached, it points to
    # the current bundles).
    location ~ ^/(en|es)/ {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /$1/index.html;
    }

    # Anything else (/, /wallets...) goes to the same page in the user's language.
    location / {
        return 302 /$ledger_locale$request_uri;
    }
}
