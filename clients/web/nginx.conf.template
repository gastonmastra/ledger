# Serves the English (/en/) and Spanish (/es/) builds and proxies the API (same origin, no CORS).

# Language chosen in the app (cookie set by the language switcher); English by default.
map $cookie_ledger_locale $ledger_locale {
    default en;
    es      es;
}

server {
    listen 80;
    root /usr/share/nginx/html;

    # Redirects keep the port the browser used (e.g. 4201).
    absolute_redirect off;

    location /api/ {
        proxy_pass http://api:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /health {
        proxy_pass http://api:8080;
    }

    # Each language is a single-page app: unknown paths fall back to its index.html.
    location ~ ^/(en|es)/ {
        try_files $uri $uri/ /$1/index.html;
    }

    # Anything else (/, /wallets...) goes to the same page in the user's language.
    location / {
        return 302 /$ledger_locale$request_uri;
    }
}
